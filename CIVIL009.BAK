#include<stdio.h>
#include<conio.h>
#include<math.h>
void main()
{
  int n,d;
  char isprime = 'y';
  clrscr();
  printf("Enter a no.:");
  scanf ("%d",&n);
  if (n == 1)
     printf("It's neither prime nor composite no.");
    else

       if(n == 2)
	printf (" it's a prime no.");
       else
   if (n % 2 == 0)
     printf(" it's not a prime no.:");
     else
     {
	for(d = 3; d <=  sqrt(n); d += 2)

	if( n % d == 0)
       {
	 isprime = 'n' ;
	 break;
	};
     if (is prime == 'y')
     printf (" it's a prime no.:");
   else
     printf (" it's not a prime no.:");

   }
     getch();

 }











